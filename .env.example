# Copy to .env for local development. On Render, set these as Environment Variables — never commit real values.

# Google Apps Script web app URL (Deploy > Web app) — see apps-script/README section in README.md
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Same value as the SECRET script property in the Apps Script project
SHEET_SECRET=change-me-long-random-string

# OpenAI key for coaching detection fallback + receipt reading
OPENAI_API_KEY=sk-...

# Dashboard login password
DASHBOARD_PASSWORD=change-me

# Optional
# PORT=3000
# TZ=Europe/Berlin
